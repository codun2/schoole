# Test environment — loaded INSTEAD of .env when APP_ENV=testing (forced by phpunit.xml).
# Pins the suite to an in-memory SQLite DB so RefreshDatabase can never touch the production MySQL.
APP_NAME=Schoole
APP_ENV=testing
APP_KEY=base64:mequnccs16AfDcKhwwnsC+7eHzG99Z/BzDTxETXiM8M=
APP_DEBUG=true
APP_URL=http://localhost
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=4
